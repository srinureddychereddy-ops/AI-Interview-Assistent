# ==============================================================================
# Interview.ai — Environment Configuration Template (.env.example)
# Copy this file to .env and replace the placeholder values with your real credentials.
# NEVER commit the actual .env file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Application Secret Key
# Used for cryptographically signing session cookies and CSRF tokens.
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-in-production

# ------------------------------------------------------------------------------
# Google Gemini API Configuration
# Used by google.generativeai for AI-driven domain insights and question hints.
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key-here

# ------------------------------------------------------------------------------
# n8n Workflow Webhook URL
# Authoritative webhook endpoint for ATS Resume Analysis & Matching pipeline.
# For local n8n Docker: http://localhost:5678/webhook/interview-analysis
# For hosted/production n8n: https://your-n8n-instance.domain.com/webhook/interview-analysis
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/interview-analysis

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Optional — for "Continue with Google" login)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure authorized redirect URI matches GOOGLE_REDIRECT_URI exactly.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/login/google/callback

# ------------------------------------------------------------------------------
# Email / Flask-Mail Configuration
# Used for sending single-use OTP codes for password reset.
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password-here
MAIL_DEFAULT_SENDER=your-email@gmail.com
